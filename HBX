    try:
        # ADMINUSER মডিউল থেকে লোগো ফাংশন কল
        if hasattr(ADMINUSER, "professional_logo"):
            ADMINUSER.professional_logo()
        else:
            print(f"{C} ⚡ 「 HBX MARKETING ENGINE 」 ⚡{RESET}")
        
        print(f"  │ {G}[+] {W}সিস্টেম আর্কিটেকচার : {G}পাসড (৬৪-বিট){RESET}")
        print(f"  │ {G}[+] {W}ইঞ্জিন স্ট্যাটাস     : {G}অনলাইন (v31.0){RESET}")
        print(f"  └────────────────────────────────────────────────────────")
        print(f"\n{G} [🚀] পোলিং সাকসেসফুলি স্টার্ট হয়েছে... কোপানো শুরু করেন মামাহ!{RESET}\n")

        # ইনফিনিটি পোলিং মেকানিজম
